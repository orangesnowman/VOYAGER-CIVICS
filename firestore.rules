rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'theorangesnowman@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users collection rules
    match /users/{userId} {
      // Allow reading user if self, admin, or assigned teacher
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        resource.data.assignedTeacherId == request.auth.uid
      );

      // Allow write if self or admin
      allow write: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin()
      );

      // Allow a signed-in teacher to link themselves to an unassigned student
      allow update: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignedTeacherId', 'assignedTeacherEmail', 'updatedAt']))
      );

      match /{allPaths=**} {
        allow read, write: if isSignedIn() && (
          request.auth.uid == userId ||
          isAdmin() ||
          (get(/databases/$(database)/documents/users/$(userId)).data.assignedTeacherId == request.auth.uid)
        );
      }
    }

    match /users {
      allow read: if isSignedIn();
    }

    // Homework collection rules
    match /homework/{homeworkId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.studentId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      );

      allow create: if isSignedIn() && (
        isAdmin() ||
        request.resource.data.teacherId == request.auth.uid
      );

      allow update: if isSignedIn() && (
        isAdmin() ||
        resource.data.studentId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      );

      allow delete: if isSignedIn() && (
        isAdmin() ||
        resource.data.teacherId == request.auth.uid
      );
    }

    // Teacher Feedback / Comments collection rules
    match /teacherFeedback/{feedbackId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.studentId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      );

      allow create: if isSignedIn() && (
        isAdmin() ||
        request.resource.data.teacherId == request.auth.uid
      );

      allow update, delete: if isSignedIn() && (
        isAdmin() ||
        resource.data.teacherId == request.auth.uid
      );
    }
  }
}
