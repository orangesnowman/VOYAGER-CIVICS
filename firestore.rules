rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'theorangesnowman@gmail.com');
      
      match /{allPaths=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'theorangesnowman@gmail.com');
      }
    }
    match /users {
      allow read: if request.auth != null;
    }
  }
}
